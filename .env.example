# MiMo Research Agent — environment config
MIMO_BASE_URL=http://localhost:20128/v1
MIMO_API_KEY=sk-local
MIMO_MODEL=xmtp/mimo-v2.5-pro

# Search APIs (optional — agent fallback to DuckDuckGo if all empty)
TAVILY_KEY=
BRAVE_API_KEY=
SERPAPI_KEY=

# Agent behavior
MAX_ITERATIONS=5
MAX_QUESTIONS=8
MAX_SOURCES=5
OUTPUT_DIR=./outputs
